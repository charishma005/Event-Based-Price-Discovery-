.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.matplotlib/
.DS_Store

# Raw provider payloads and derived research data are local-only.
data/raw/databento/*
data/raw/alphavantage/*
data/processed/*
!data/raw/databento/.gitkeep
!data/raw/alphavantage/.gitkeep
!data/processed/.gitkeep

# Generated figures and transient files.
figures/*
!figures/.gitkeep
tmp/

# Small derived FOMC results needed to rerun the surprise tests (no raw vendor data).
!data/processed/fomc_sample/
data/processed/fomc_sample/*
!data/processed/fomc_sample/speed_metrics.parquet
!data/processed/fomc_sample/mechanism_summary_60s.parquet
!data/processed/fomc_sample/raw_coverage.csv
!data/processed/fomc_sample/response_horizons.csv
!data/processed/fomc_sample/timing_liquidity.csv
!data/processed/fomc_sample_2015/
data/processed/fomc_sample_2015/*
!data/processed/fomc_sample_2015/speed_metrics.parquet
!data/processed/fomc_sample_2015/mechanism_summary_60s.parquet
!data/processed/fomc_sample_2015/raw_coverage.csv
!data/processed/fomc_sample_2015/response_horizons.csv
!data/processed/fomc_sample_2015/timing_liquidity.csv
!data/processed/fomc_sample_2015_2023/
data/processed/fomc_sample_2015_2023/*
!data/processed/fomc_sample_2015_2023/speed_metrics.parquet
!data/processed/fomc_sample_2015_2023/mechanism_summary_60s.parquet
!data/processed/fomc_sample_2015_2023/raw_coverage.csv
!data/processed/fomc_sample_2015_2023/response_horizons.csv
!data/processed/fomc_sample_2015_2023/timing_liquidity.csv
!figures/fomc_sample_2015_2023/
